# Public, non-secret, client-approved HTTPS origin only. Leave empty for local preview.
# Do not put credentials, a path or a preview deployment hostname here.
NEXT_PUBLIC_SITE_URL=

# Default: previews must not be indexed. Set both only for the approved launch build.
SITE_DEPLOYMENT_ENV=preview
SITE_INDEXING_ENABLED=false

# Keep any future delivery credentials server-only; never prefix secrets NEXT_PUBLIC_.
